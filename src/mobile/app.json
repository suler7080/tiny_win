{
  "expo": {
    "name": "Tiny Win",
    "slug": "tiny-win",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#09090B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tinywin.app"
    },
    "android": {
      "package": "com.tinywin.app",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#09090B"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "9404f56d-8b2f-41ed-8811-3efe52c1a840"
      }
    }
  }
}
